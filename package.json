{
  "name": "obsidian-lean-coder",
  "version": "0.0.1",
  "description": "Obsidian Lean Coder — OpenCode extension for project-scoped planning, memory, and safe Git checkpoints.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "agents",
    "skills",
    "templates"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.tests.json && node --test \"dist-tests/tests/**/*.test.js\"",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@opencode/plugin": "^2.0.27"
  }
}
